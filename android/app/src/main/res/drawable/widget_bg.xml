<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- very light dark scrim so white text stays readable on bright wallpapers -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- the glass itself: a faint white veil, the wallpaper shows through -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- light catching the top edge -->
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3AFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
    <!-- bright glass edge -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#78FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
